prop World.FetchedLeaderboard

pub preference owner.HasPlayedBefore

pub page fn owner.HomePage {    
    Music(@stackMastersTheme.mp3, loop=true)

    Toolbar {
        VolumeToggle
    }

    ToolbarRight {
        if IsUserLoggedIn {
            FlatButton(ManageAccountIntent, backgroundColor=#fff1) { %(PlayerName) }
        } else {
            FlatButton(LoginIntent, backgroundColor=Color:Primary) { "Login" }
        }
    }
    
    Content {
        Panel(backgroundColor=#620080, animate=Animate:FlyFromTop) {
            HStack {
                VStack {
                    H1(margin=0) { %(ProjectName) }
                    P { "Do you lack or do you stack?" }
                }
                Blank(expand=true)
                RaisedButton(Main, autoClick=!HasPlayedBefore, backgroundColor=Color:Primary, width=20, fontSize=2, borderRounding=1, animate=Animate:Throb) { "Play" }
            }
        }
        
        InsetPanel {
            HStack {
                "Choose your name: "
                Blank(expand=true)
                VStack(width=20) {
                    PlayerNameEditor
                }
            }
        }

        P(fontSize=0.9, color=#aaa) {
            "This game was made with "
            Link("https://easel.games") { "Easel" }
            " - the remixable online game engine for humans!"
        }
        
        H2 { "Leaderboard" }

        if !IsUserLoggedIn && HighestElapsedDuration > 0 {
            ShinyPanel(align=Align:Center, vPadding=0.5, backgroundColor=#f60) {
                P(fontSize=0.8) {
                    Icon("fa-solid fa-triangle-exclamation")
                    " You are not logged in. Unregistered high scores get deleted after 90 days. To keep your score forever, you need to "
                    Link(LoginIntent) { "login" }
                    "."
                }
            }
        }

        with FetchedLeaderboard, PlayerName {
            if FetchedLeaderboard {
                let foundMyself = false
                let rank = 1
                for player in FetchedLeaderboard %%{
                    let isMe = player.UserId == owner.UserId
                    if isMe { foundMyself = true }
                    
                    ShinyPanel(backgroundColor=isMe ? #f80 : #b0f, vPadding=0.4) {
                        HStack {
                            P(fontSize=0.75, color=#eee, width=1.5, align=Align:Center) {
                                %(rank)
                            }
                            P(fontSize=isMe ? 1.5 : 1.2, bold=true) {
                                PlayerNameDisplay(isMe ? owner : player, color=#fff)
                            }
        
                            Blank(expand=true)
        
                            P {
                                %(Round(player.HighestElapsedDuration / 1s))
                                " seconds"
                            }
                        }
                    }
        
                    rank += 1
                }

                if HighestElapsedDuration > 0 && !foundMyself {
                    Blank(height=1)
                    ShinyPanel(backgroundColor=#f80, vPadding=0.4) {
                        HStack {
                            P(fontSize=0.75, color=#eee, width=1.5, align=Align:Center) {
                                "?"
                            }
                            P(fontSize=1.5, bold=true) {
                                PlayerNameDisplay(color=#fff)
                            }
        
                            Blank(expand=true)
        
                            P {
                                %(Round(HighestElapsedDuration / 1s))
                                " seconds"
                            }
                        }
                    }
                }
        
                if FetchedLeaderboard.IsEmpty {
                    P { "No one on the leaderboard... yet" }
                }
            } else {
                P { "Loading..." }
            }
        }
    }

    FetchedLeaderboard = await FetchLeaderboard(&HighestElapsedDuration)
}