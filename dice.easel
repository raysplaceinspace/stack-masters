pub prop dice.DiceNumber

const DiceNoiseInterval = 0.5s
field dice.DiceSilentUntil = 0

pub collect round.AllDice
pub collect World.DiceTouchingFloor

const DiceColorLookup = {
    1 = #f88,
    2 = #ff8,
    3 = #8f8,
    4 = #8ff,
    5 = #88f,
    6 = #f8f,
}

const DiceDotsLookup = {
    1 = @dots1.svg,
    2 = @dots2.svg,
    3 = @dots3.svg,
    4 = @dots4.svg,
    5 = @dots5.svg,
    6 = @dots6.svg,
}

pub fn dice.Dice(pos, diceNumber) {
    use body=dice
    use radius=1, shape=Equilateral(numPoints=4, angle=0.125rev)
    
    DiceNumber = diceNumber
    use color=DiceColorLookup[DiceNumber].Darken(0.25*Random)

    DiceSilentUntil = Tick + 0.1s // No sound when spawning

    Body(pos=, heading=Random*1rev)
    PolygonCollider(category=Category:Dice, friction=0.03)
    ImageSprite(@dice.svg, shading=0.5, shadow=0.25, color=)
    ImageSprite(DiceDotsLookup[DiceNumber], color=#fff)

    on BeforeCollide that {
        if that.Category.Overlaps(Category:Dice) {
            if Speed > that.Speed && Tick > DiceSilentUntil && Tick > that.DiceSilentUntil {
                DiceSilentUntil = that.DiceSilentUntil = Tick + DiceNoiseInterval
                Hear(PickRandom(@diceHitDice*.esfx), volume=(Speed / 10).Clamp(0,1))
            }
        } else if that.Category.Overlaps(Category:Boundary) {
            if that.BoundaryIsFloor {
                give<touchingFloor> DiceTouchingFloor(dice)
            }
        }
    }
    on AfterCollide that {
        if that.Category.Overlaps(Category:Boundary) && that.BoundaryIsFloor {
            delete give<touchingFloor>
        }
    }

    once BeforeDespawn {
        repeat 2 {
            Spark(luminous=1, shine=0.5, bloom=3, bloomAlpha=1, speed=10, dissipate=0.25s)
        }
    }
}

pub fn this.DiceDismantler(numDiceInRow) |color| {
    with DiceTouchingFloor {
        if DiceTouchingFloor.Length >= numDiceInRow {
            use diceNumber = DiceTouchingFloor[0].DiceNumber
            if DiceTouchingFloor.All(|dice| dice.DiceNumber == diceNumber) {
                Hear(@diceRowEliminated.esfx)
                // All are the same number, so we have a whole row
                for dice in DiceTouchingFloor {
                    dice.Expire
                }

                delve(color=DiceColorLookup[diceNumber])
            }
        }
    }
}

pub fn this.DiceManipulator([owner]) {
    on ButtonDown(Click) {
        use dice = Pointer.QueryNearest(filter=Category:Dice)
        use body=dice
        behavior<dragDice> on BeforePhysics {
            if !dice.Exists { break }
            let posDelta = Pointer - (Pos + 2 * Velocity / 1s)
            
            let targetVelocity = posDelta * 1s
            let velocityDelta = (targetVelocity - Velocity).Truncate(100)

            ApplyImpulse(0.25 * velocityDelta * Mass)
            dice.Strobe(shine=0.25)
        }

        await ButtonUp(Click)
        delete behavior<dragDice>

        if dice.Exists {
            Velocity = Velocity.Truncate(50)
        }
    }
}

pub await fn round.SpawnNDice(diceNumbers, perNumber, spawnInterval=0.1s) {
    let remaining = []
    for diceNumber in diceNumbers {
        repeat perNumber {
            remaining.Push(diceNumber)
        }
    }
    Shuffle(remaining)

    while !remaining.IsEmpty {
        let diceNumber = remaining.Pop
        
        Spawn dice {
            Dice(pos=@(1 * SignedRandom, -20), diceNumber=)
            give AllDice(dice)
        }

        await Tick(spawnInterval)
    }
}

pub fn round.HasEnoughMatchingDice(minMatching) -> boolean {
    let counts = {}
    for use dice in AllDice {
        counts[DiceNumber] += 1
    }
    return counts.Any(|v| v >= minMatching)
}