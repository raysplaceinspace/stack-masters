pub field boundary.BoundaryIsFloor

pub prop World.BoundaryColor = #326

pub fn boundary.Boundary(pos, heading, width=1000, height=10, isFloor?) {
    use body=boundary
    use shape=Rectangle(width=, height=)

    BoundaryIsFloor = isFloor

    Body(
        pos=,
        heading=,
        immovable=true, noRotation=true,
    )
    PolygonCollider(category=Category:Boundary)

    with BoundaryColor {
        PolygonSprite(color=BoundaryColor)
    }
}